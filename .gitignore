# Python / venv
.venv/
__pycache__/
*.pyc
.python-version

# dbt
target/
dbt_packages/
logs/
.user.yml

# Local profiles — never commit credentials
profiles.yml
.dbt/

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store

# Local data dumps (CMS files are huge — never commit)
data/
*.csv
*.csv.gz
*.parquet
!seeds/**/*.csv
# Pre-materialized Hex static datasets — small (~1 MB total), intentionally
# committed so the published Hex app stays interactive after the Snowflake
# trial warehouse lapses. Generated by setup/06_extract_hex_static.py.
!docs/hex_data/*.csv
# Evidence app source data — small CSV extracts the CI build reads to render /app
!reports/sources/**/*.csv

# Secrets
.env
.env.*
!.env.example
